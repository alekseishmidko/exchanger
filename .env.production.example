# Безопасный production template: credentials и connection strings запрещены.
NODE_ENV=production
RUNTIME_PROFILE=production
COMMAND_STORE_ADAPTER=postgres
LEDGER_STORE_ADAPTER=postgres
EVENT_LOG_ADAPTER=postgres-outbox
IDEMPOTENCY_STORE_ADAPTER=postgres
AUDIT_STORE_ADAPTER=postgres
SEQUENCER_STORE_ADAPTER=postgres
PROJECTION_STORE_ADAPTER=postgres
ADMISSION_CONTROL_ADAPTER=postgres
INSTANCE_ID=exchange-backend-1
PARTITION_LEASE_TTL_MS=15000
DEPENDENCY_PROBE_TIMEOUT_MS=1000
# POSTGRES_PASSWORD и прочие credentials передаются deployment secret store.
POSTGRES_POOL_MAX=20
POSTGRES_CONNECTION_TIMEOUT_MS=2000
POSTGRES_QUERY_TIMEOUT_MS=2000
POSTGRES_IDLE_TIMEOUT_MS=30000
SERVICE_NAME=exchange-backend
BUILD_VERSION=replace-at-deploy
HOST=0.0.0.0
PORT=5000
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
WEBSOCKET_ALLOWED_ORIGINS=https://exchange.example.com
WEBSOCKET_MAX_SUBSCRIBERS=10000
WEBSOCKET_MAX_PENDING=100
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_MS=60000
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=1000
OTEL_DIAGNOSTIC_SPAN_LIMIT=1000
