# Безопасная конфигурация Jest/contract tests для чистого checkout.
NODE_ENV=test
RUNTIME_PROFILE=component
COMMAND_STORE_ADAPTER=memory
LEDGER_STORE_ADAPTER=memory
EVENT_LOG_ADAPTER=memory
IDEMPOTENCY_STORE_ADAPTER=memory
AUDIT_STORE_ADAPTER=memory
SEQUENCER_STORE_ADAPTER=memory
PROJECTION_STORE_ADAPTER=memory
ADMISSION_CONTROL_ADAPTER=memory
INSTANCE_ID=test-backend-1
PARTITION_LEASE_TTL_MS=15000
DEPENDENCY_PROBE_TIMEOUT_MS=1000
POSTGRES_QUERY_TIMEOUT_MS=2000
WORKERS_ENABLED=false
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=1
WORKER_TIMEOUT_MS=1000
WORKER_MAX_ATTEMPTS=2
WORKER_BASE_BACKOFF_MS=1
WORKER_MAX_BACKOFF_MS=10
WORKER_POLL_INTERVAL_MS=1000
SERVICE_NAME=exchange-backend
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_MS=60000
AUTH_USER_STORE_ADAPTER=memory
AUTH_SESSION_STORE_ADAPTER=memory
AUTH_API_KEY_STORE_ADAPTER=memory
AUTH_PASSWORD_PEPPER=component-password-pepper-not-for-production-2026
AUTH_TOKEN_HASH_SECRET=component-token-hmac-secret-not-for-production-2026
AUTH_DUMMY_PASSWORD_HASH='scrypt$16384$8$1$ABEiM0RVZneImaq7zN3u_w$DZ1tZcbkavfuen6HDCxkh17VbrwawMLn9jfU1awYfAQ'
AUTH_TOKEN_TRANSPORT=cookie
AUTH_COOKIE_NAME=exchange_session
AUTH_CSRF_COOKIE_NAME=exchange_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_RECOVERY_TTL_SECONDS=900
AUTH_TEST_BYPASS_ENABLED=false
BUILD_VERSION=test
HOST=127.0.0.1
PORT=5000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001
WEBSOCKET_MAX_SUBSCRIBERS=100
WEBSOCKET_MAX_PENDING=20
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
OTEL_TRACES_ENABLED=false
OTEL_BSP_MAX_QUEUE_SIZE=128
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=32
OTEL_BSP_SCHEDULE_DELAY=100
OTEL_BSP_EXPORT_TIMEOUT=100
OTEL_DIAGNOSTIC_SPAN_LIMIT=200
