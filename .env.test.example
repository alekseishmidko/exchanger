# Безопасная конфигурация Jest/contract tests для чистого checkout.
NODE_ENV=test
SERVICE_NAME=exchange-backend
BUILD_VERSION=test
HOST=127.0.0.1
PORT=5000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001
WEBSOCKET_MAX_SUBSCRIBERS=100
WEBSOCKET_MAX_PENDING=20
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
OTEL_TRACES_ENABLED=false
OTEL_BSP_MAX_QUEUE_SIZE=128
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=32
OTEL_BSP_SCHEDULE_DELAY=100
OTEL_BSP_EXPORT_TIMEOUT=100
OTEL_DIAGNOSTIC_SPAN_LIMIT=200
