# Безопасные значения для локального запуска и GitHub Actions.
NODE_ENV=development
SERVICE_NAME=exchange-backend
BUILD_VERSION=development
HOST=0.0.0.0
PORT=5000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001
WEBSOCKET_MAX_SUBSCRIBERS=1000
WEBSOCKET_MAX_PENDING=100
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
