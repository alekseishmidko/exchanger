# Безопасные значения для локального запуска и GitHub Actions.
NODE_ENV=development
RUNTIME_PROFILE=component
COMMAND_STORE_ADAPTER=memory
LEDGER_STORE_ADAPTER=memory
EVENT_LOG_ADAPTER=memory
IDEMPOTENCY_STORE_ADAPTER=memory
AUDIT_STORE_ADAPTER=memory
SEQUENCER_STORE_ADAPTER=memory
PROJECTION_STORE_ADAPTER=memory
ADMISSION_CONTROL_ADAPTER=memory
INSTANCE_ID=development-backend-1
PARTITION_LEASE_TTL_MS=15000
DEPENDENCY_PROBE_TIMEOUT_MS=1000
POSTGRES_QUERY_TIMEOUT_MS=2000
WORKERS_ENABLED=true
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=1
WORKER_TIMEOUT_MS=5000
WORKER_MAX_ATTEMPTS=3
WORKER_BASE_BACKOFF_MS=25
WORKER_MAX_BACKOFF_MS=1000
WORKER_POLL_INTERVAL_MS=1000
SERVICE_NAME=exchange-backend
BUILD_VERSION=development
HOST=0.0.0.0
PORT=5000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:5173
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:5173
WEBSOCKET_MAX_SUBSCRIBERS=1000
WEBSOCKET_MAX_PENDING=100
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_MS=60000
AUTH_USER_STORE_ADAPTER=memory
AUTH_SESSION_STORE_ADAPTER=memory
AUTH_API_KEY_STORE_ADAPTER=memory
AUTH_PASSWORD_PEPPER=component-password-pepper-not-for-production-2026
AUTH_TOKEN_HASH_SECRET=component-token-hmac-secret-not-for-production-2026
AUTH_DUMMY_PASSWORD_HASH='scrypt$16384$8$1$ABEiM0RVZneImaq7zN3u_w$DZ1tZcbkavfuen6HDCxkh17VbrwawMLn9jfU1awYfAQ'
AUTH_TOKEN_TRANSPORT=cookie
AUTH_COOKIE_NAME=exchange_session
AUTH_CSRF_COOKIE_NAME=exchange_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_RECOVERY_TTL_SECONDS=900
AUTH_TEST_BYPASS_ENABLED=false
TWELVE_DATA_ENABLED=false
# Секрет задаётся только в ignored .env.development или secret store.
TWELVE_DATA_API_KEY=
TWELVE_DATA_CATALOG_SYNC_ON_START=false
TWELVE_DATA_ASSET_CLASSES=crypto,forex
TWELVE_DATA_REST_URL=https://api.twelvedata.com
TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
TWELVE_DATA_REDIS_URL=redis://127.0.0.1:6380
TWELVE_DATA_REQUEST_TIMEOUT_MS=5000
TWELVE_DATA_QUOTE_MAX_AGE_MS=5000
TWELVE_DATA_QUOTE_TTL_MS=15000
TWELVE_DATA_HEARTBEAT_MS=10000
TWELVE_DATA_SUBSCRIBE_ACK_TIMEOUT_MS=10000
TWELVE_DATA_RECONNECT_MIN_MS=1000
TWELVE_DATA_RECONNECT_MAX_MS=30000
TWELVE_DATA_LEADER_TTL_MS=15000
TWELVE_DATA_MAX_SYMBOLS=100
TWELVE_DATA_REST_BOOTSTRAP_LIMIT=10
TWELVE_DATA_CATALOG_PAGE_SIZE=1000
TWELVE_DATA_CATALOG_MAX_PAGES=10
REALTIME_EXECUTION_ENABLED=false
REALTIME_EXECUTION_FEE_RATE=0
REALTIME_MAX_SUBSCRIPTIONS_PER_SOCKET=20
REALTIME_MAX_PENDING_MESSAGES=100
# REALTIME_LIQUIDITY_ACCOUNT_ID и REALTIME_FEE_ACCOUNT_ID задаются при включении execution.
TWELVE_DATA_CATALOG_SYNC_INTERVAL_MS=86400000
TWELVE_DATA_CATALOG_MIN_RETAINED_RATIO=0.5
# Docker Compose автоматически заменяет host URL на redis://redis:6379.
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=1000
OTEL_DIAGNOSTIC_SPAN_LIMIT=1000
