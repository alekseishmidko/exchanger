{
  "name": "exchange",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --filter @exchange/backend start:dev",
    "docker:development": "docker compose -f docker-compose.development.yml up --build",
    "docker:production": "docker compose -f docker-compose.production.yml up --build -d",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose -f docker-compose.staging.yml --profile load --profile fault-injection --profile resource-injection --profile ha down --volumes --remove-orphans",
    "test": "corepack pnpm -r test",
    "test:cov": "corepack pnpm -r test:cov",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "format": "corepack pnpm -r format",
    "format:check": "corepack pnpm --filter @exchange/backend format:check",
    "security:check": "node scripts/check-repository.mjs",
    "contracts:check": "corepack pnpm --filter @exchange/backend contracts:check",
    "observability:check": "corepack pnpm --filter @exchange/backend test -- src/modules/observability/metrics.spec.ts src/modules/observability/tracing.spec.ts src/modules/observability/observability-config.spec.ts --runInBand",
    "docker:observability": "docker compose -f docker-compose.development.yml -f docker-compose.observability.yml up --build",
    "docker:observability:down": "docker compose -f docker-compose.development.yml -f docker-compose.observability.yml down --volumes",
    "api:flows": "node scripts/run-api-flows-development.mjs",
    "api:flows:check": "node scripts/run-api-flows.mjs",
    "api:flows:development": "node scripts/run-api-flows-development.mjs",
    "postgres:backup-restore": "node scripts/verify-postgres-backup-restore.mjs",
    "load:check": "node scripts/check-load-suite.mjs",
    "load:smoke": "node scripts/run-load-test.mjs smoke",
    "load:average": "node scripts/run-load-test.mjs average",
    "load:stress": "node scripts/run-load-test.mjs stress",
    "load:spike": "node scripts/run-load-test.mjs spike",
    "load:soak": "node scripts/run-load-test.mjs soak",
    "load:breakpoint": "node scripts/run-load-test.mjs breakpoint",
    "chaos:check": "node scripts/check-chaos-suite.mjs",
    "chaos:component": "corepack pnpm --filter @exchange/backend test -- test/resilience-chaos.spec.ts --runInBand",
    "chaos:observability": "node scripts/run-chaos-test.mjs observability-outage",
    "resilience:network": "node scripts/run-staging-resilience.mjs network-faults",
    "resilience:postgres-failover": "node scripts/run-staging-resilience.mjs postgres-failover",
    "resilience:process-kill": "node scripts/run-staging-resilience.mjs durable-process-kill",
    "resilience:contention": "node scripts/run-staging-resilience.mjs postgres-contention",
    "resilience:resource-pressure": "node scripts/run-staging-resilience.mjs resource-pressure",
    "resilience:rolling": "node scripts/run-staging-resilience.mjs rolling-ownership",
    "resilience:controls": "node scripts/run-staging-resilience.mjs controls-under-load",
    "resilience:staging": "node scripts/run-staging-resilience-suite.mjs"
  }
}
