{
  "uid": "exchange-overview",
  "title": "Exchange / SLO Overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["exchange", "slo", "owner:platform"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Availability", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "1 - sum(rate(exchange_http_requests_total{status_class=~\"5..\"}[5m])) / clamp_min(sum(rate(exchange_http_requests_total[5m])), 0.001)"}], "fieldConfig": {"defaults": {"noValue": "No traffic", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}}, "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "HTTP p50 / p95 / p99", "datasource": {"uid": "prometheus"}, "targets": [{"legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(exchange_http_request_duration_seconds_bucket[5m])))"}, {"legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(exchange_http_request_duration_seconds_bucket[5m])))"}, {"legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(exchange_http_request_duration_seconds_bucket[5m])))"}], "fieldConfig": {"defaults": {"noValue": "No samples"}}, "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Projection and consumer lag", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "exchange_projection_lag_events"}, {"expr": "exchange_consumer_lag_events"}], "fieldConfig": {"defaults": {"noValue": "Consumer inactive", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}]}}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "type": "timeseries", "title": "Runtime / dependencies USE", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "exchange_resource_utilization_ratio"}, {"expr": "exchange_resource_saturation_ratio"}, {"expr": "rate(exchange_resource_errors_total[5m])"}], "fieldConfig": {"defaults": {"noValue": "Resource not configured", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Business correctness", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(exchange_settlement_total{outcome=\"failed\"}[5m])"}, {"expr": "rate(exchange_reconciliation_differences_total[5m])"}, {"expr": "rate(exchange_sequence_gaps_total[5m])"}], "fieldConfig": {"defaults": {"noValue": "No violations"}}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}}
  ]
}
