# Воспроизводимые credentials только для локального/CI staging-контура.
# Этот файл запрещено использовать как production secret source.
NODE_ENV=production
RUNTIME_PROFILE=production
COMMAND_STORE_ADAPTER=postgres
LEDGER_STORE_ADAPTER=postgres
EVENT_LOG_ADAPTER=postgres-outbox
IDEMPOTENCY_STORE_ADAPTER=postgres
AUDIT_STORE_ADAPTER=postgres
SEQUENCER_STORE_ADAPTER=postgres
PROJECTION_STORE_ADAPTER=postgres
ADMISSION_CONTROL_ADAPTER=postgres
PARTITION_LEASE_TTL_MS=2000
DEPENDENCY_PROBE_TIMEOUT_MS=1000
POSTGRES_POOL_MAX=8
POSTGRES_CONNECTION_TIMEOUT_MS=1000
POSTGRES_QUERY_TIMEOUT_MS=1500
POSTGRES_IDLE_TIMEOUT_MS=5000
WORKERS_ENABLED=true
WORKER_BATCH_SIZE=100
WORKER_CONCURRENCY=1
WORKER_TIMEOUT_MS=5000
WORKER_MAX_ATTEMPTS=3
WORKER_BASE_BACKOFF_MS=25
WORKER_MAX_BACKOFF_MS=1000
WORKER_POLL_INTERVAL_MS=1000
SERVICE_NAME=exchange-backend
BUILD_VERSION=staging-local
HOST=0.0.0.0
PORT=5000
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
APPLICATION_PUBLIC_URL=https://localhost:5443
WEBSOCKET_ALLOWED_ORIGINS=https://localhost:5443
HTTP_ALLOWED_ORIGINS=https://localhost:5443
TRUSTED_PROXY_CIDRS=172.16.0.0/12
WEBSOCKET_MAX_SUBSCRIBERS=1000
WEBSOCKET_MAX_PENDING=100
WEBSOCKET_MAX_CONNECTIONS_PER_IP=50
WEBSOCKET_MAX_MESSAGES_PER_WINDOW=1000
WEBSOCKET_MESSAGE_WINDOW_MS=60000
WEBSOCKET_MAX_SUBSCRIPTIONS_PER_SOCKET=50
GATEWAY_RATE_LIMIT=100000
GATEWAY_RATE_WINDOW_MS=60000
AUTH_RATE_GLOBAL_LIMIT=100000
AUTH_USER_STORE_ADAPTER=postgres
AUTH_SESSION_STORE_ADAPTER=redis
AUTH_API_KEY_STORE_ADAPTER=postgres
AUTH_TOKEN_TRANSPORT=cookie
# AUTH_PASSWORD_PEPPER, AUTH_TOKEN_HASH_SECRET, AUTH_DUMMY_PASSWORD_HASH и
# AUTH_REDIS_URL=rediss://<acl-user>:<secret>@<host>:<port> приходят из .env.staging/secret store.
AUTH_COOKIE_NAME=__Host-exchange_session
AUTH_CSRF_COOKIE_NAME=__Host-exchange_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_RECOVERY_TTL_SECONDS=900
AUTH_RECOVERY_MIN_RESPONSE_MS=250
AUTH_RECOVERY_DELIVERY_TIMEOUT_MS=2000
AUTH_RECOVERY_DELIVERY_MAX_ATTEMPTS=3
AUTH_RECOVERY_DELIVERY_BACKOFF_MS=100
AUTH_RETENTION_INTERVAL_MS=60000
AUTH_RETENTION_BATCH_SIZE=500
AUTH_REDIS_COMMAND_TIMEOUT_MS=750
AUTH_SCRYPT_COST=16384
AUTH_PASSWORD_PEPPER_VERSION=v1
WEBSOCKET_AUTH_RECHECK_MS=5000
AUTH_RECOVERY_DELIVERY_URL=https://mail-sink.example.test/internal/auth-delivery
AUTH_RECOVERY_DECOY_EMAIL=security-decoy@example.test
# AUTH_RECOVERY_DELIVERY_SECRET приходит из .env.staging/secret store.
AUTH_TEST_BYPASS_ENABLED=false
LOG_SAMPLE_LIMIT=100
LOG_SAMPLE_WINDOW_MS=10000
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_BSP_MAX_QUEUE_SIZE=1024
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_EXPORT_TIMEOUT=500
OTEL_DIAGNOSTIC_SPAN_LIMIT=1000
